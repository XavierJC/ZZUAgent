# Optional local configuration. Environment variables take precedence.
# Copy to .env and enter your own key; never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
EDUAGENT_AGENT_ENABLED=false
EDUAGENT_RETRIEVAL_ENABLED=true
EDUAGENT_MODEL_TIMEOUT=25
EDUAGENT_MODEL_MAX_CALLS=3
EDUAGENT_MODEL_MAX_TOKENS=700
# Workbench chat only; does not change legacy tutor or study-guide output limits.
EDUAGENT_WORKBENCH_MAX_TOKENS=1500
# Phase4B-1 originals/derived files default beside the database (*.documents).
# EDUAGENT_DOCUMENT_DIR=data/local/eduagent.documents
# Keep off until separate page-vision budget and material transmission approval.
EDUAGENT_DOCUMENT_VISION_ENABLED=false
